# Text generation and research
GROQ_API_KEY=
SERPER_API_KEY=
SOCIAL_POST_MODEL=groq/openai/gpt-oss-20b
SOCIAL_POST_RATE_LIMIT_MAX_RETRIES=12
SOCIAL_POST_RATE_LIMIT_MAX_WAIT_SECONDS=60
SOCIAL_POST_STRUCTURED_OUTPUT_RETRIES=2

# Local application
SOCIAL_POST_DATA_DIR=.data
SOCIAL_POST_HOST=127.0.0.1
SOCIAL_POST_PORT=8000
SOCIAL_POST_FOOTER=
SOCIAL_POST_PRIMARY_COLOR=#0A66C2
SOCIAL_POST_ACCENT_COLOR=#7C3AED

# LinkedIn developer application (Share on LinkedIn product required)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8000/auth/linkedin/callback
LINKEDIN_API_VERSION=202609
